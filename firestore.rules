/**
 * @file Firebase Security Rules for EduBlock Prototyping.
 *
 * @Core Philosophy:
 *   This ruleset enforces a strict user-ownership model for user profiles (admins, principals, students, employers) and
 *   certificate issuance.  Access is generally restricted to the owner of a resource, with some allowances for public
 *   read access where explicitly intended. The rules are written to be highly secure from an authorization standpoint
 *   but flexible on data shapes to allow for rapid iteration.  Schema validation is minimal and focuses on relational integrity.
 *
 * @Data Structure:
 *   - /admins/{adminId}: Stores administrator user accounts.
 *   - /principals/{principalId}: Stores principal user accounts.
 *   - /principals/{principalId}/students/{studentId}: Stores student accounts managed by principals. The principalId is denormalized here.
 *   - /employers/{employerId}: Stores employer user accounts.
 *   - /certificates/{certificateId}: Stores certificates. Includes denormalized 'principalId' and 'studentId' for authorization independence.
 *
 * @Key Security Decisions:
 *   - User listing is generally disallowed unless explicitly stated.
 *   - Public read access is granted to the /certificates collection.
 *   - Write access is strictly controlled based on ownership and relational integrity checks.
 *
 * @Denormalization for Authorization:
 *   - Certificates denormalize principalId and studentId to allow for authorization checks without requiring additional `get()` calls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description: Controls access to administrator user profiles. Only the admin themselves can read or write their profile.
     * @path: /admins/{adminId}
     * @allow: (get, update, delete) - User with UID matching {adminId}.
     * @allow: (create) - User with UID matching {adminId} when creating the document.
     * @deny: (get, update, delete) - User with UID not matching {adminId}.
     * @deny: (create) - User with UID not matching {adminId} when creating the document.
     * @principle: Enforces document ownership for all operations.
     */
    match /admins/{adminId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(adminId) {
        return request.auth.uid == adminId;
      }

      function isExistingOwner(adminId) {
          return isSignedIn() && isOwner(adminId) && resource.data != null;
      }

      allow get: if isOwner(adminId);
      allow list: if false; // Do not allow listing of admins.
      allow create: if isSignedIn() && isOwner(adminId);
      allow update: if isExistingOwner(adminId);
      allow delete: if isExistingOwner(adminId);
    }

    /**
     * @description: Controls access to principal user profiles. Only the principal themselves can read or write their profile.
     * @path: /principals/{principalId}
     * @allow: (get, update, delete) - User with UID matching {principalId}.
     * @allow: (create) - User with UID matching {principalId} when creating the document.
     * @deny: (get, update, delete) - User with UID not matching {principalId}.
     * @deny: (create) - User with UID not matching {principalId} when creating the document.
     * @principle: Enforces document ownership for all operations.
     */
    match /principals/{principalId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(principalId) {
        return request.auth.uid == principalId;
      }

       function isExistingOwner(principalId) {
          return isSignedIn() && isOwner(principalId) && resource.data != null;
      }

      allow get: if isOwner(principalId);
      allow list: if false; // Do not allow listing of principals.
      allow create: if isSignedIn() && isOwner(principalId);
      allow update: if isExistingOwner(principalId);
      allow delete: if isExistingOwner(principalId);
    }

    /**
     * @description: Controls access to student user profiles nested under a principal.
     *               Only the principal who owns the student profile can read or write it.
     * @path: /principals/{principalId}/students/{studentId}
     * @allow: (get, list, update, delete) - Principal with UID matching {principalId}.
     * @allow: (create) - Principal with UID matching {principalId} when creating the document.  Also validates that the studentId matches the document ID in the path.
     * @deny: (get, list, update, delete) - Principal with UID not matching {principalId}.
     * @deny: (create) - Principal with UID not matching {principalId} when creating the document.
     * @principle: Enforces document ownership by the principal.  Validates that the studentId matches the document ID.
     */
    match /principals/{principalId}/students/{studentId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(principalId) {
        return request.auth.uid == principalId;
      }

      function isExistingOwner(principalId) {
          return isSignedIn() && isOwner(principalId) && resource.data != null;
      }

      allow get: if isOwner(principalId);
      allow list: if isOwner(principalId);
      allow create: if isSignedIn() && isOwner(principalId);
      allow update: if isExistingOwner(principalId);
      allow delete: if isExistingOwner(principalId);
    }

    /**
     * @description: Controls access to employer user profiles. Only the employer themselves can read or write their profile.
     * @path: /employers/{employerId}
     * @allow: (get, update, delete) - User with UID matching {employerId}.
     * @allow: (create) - User with UID matching {employerId} when creating the document.
     * @deny: (get, update, delete) - User with UID not matching {employerId}.
     * @deny: (create) - User with UID not matching {employerId} when creating the document.
     * @principle: Enforces document ownership for all operations.
     */
    match /employers/{employerId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(employerId) {
        return request.auth.uid == employerId;
      }

       function isExistingOwner(employerId) {
          return isSignedIn() && isOwner(employerId) && resource.data != null;
      }

      allow get: if isOwner(employerId);
      allow list: if false; // Do not allow listing of employers.
      allow create: if isSignedIn() && isOwner(employerId);
      allow update: if isExistingOwner(employerId);
      allow delete: if isExistingOwner(employerId);
    }

    /**
     * @description: Controls access to certificates. Certificates are publicly readable, but can only be created by a Principal
     *               and can only be updated/deleted by the principal who created it or the student it belongs to.  The principalId and studentId must exist in the document.
     * @path: /certificates/{certificateId}
     * @allow: (get, list) - Any user (public read).
     * @allow: (create) - Principal with UID matching request.resource.data.principalId. Also enforces that request.resource.data.studentId exists.
     * @allow: (update, delete) - Principal with UID matching certificate.principalId OR Student with UID matching certificate.studentId. Document must exist.
     * @deny: (create) - If request.resource.data.principalId does not match the authenticated user.
     * @principle: Public read, owner-only writes, with ownership defined by principalId and studentId fields.
     */
    match /certificates/{certificateId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwnerByPrincipal(principalId) {
        return isSignedIn() && request.auth.uid == principalId;
      }

      function isOwnerByStudent(studentId) {
          return isSignedIn() && request.auth.uid == studentId;
      }

      function isExistingOwnerByPrincipal(principalId) {
          return isSignedIn() && isOwnerByPrincipal(principalId) && resource.data != null;
      }

      function isExistingOwnerByStudent(studentId) {
          return isSignedIn() && isOwnerByStudent(studentId) && resource.data != null;
      }


      allow get, list: if true;
      allow create: if isSignedIn() && isOwnerByPrincipal(request.resource.data.principalId);
      allow update: if isExistingOwnerByPrincipal(resource.data.principalId) || isExistingOwnerByStudent(resource.data.studentId);
      allow delete: if isExistingOwnerByPrincipal(resource.data.principalId) || isExistingOwnerByStudent(resource.data.studentId);
    }
  }
}